{
  "_version": "1.76.0",
  "sap.app": {
    "id": "allorders",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.20.0",
      "toolsId": "dcc6b4d7-0b09-4515-95a0-f3e884a6f608"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/order-issue/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.143.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "allorders.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "OrdersList",
          "target": "OrdersList"
        },
        {
          "pattern": "Orders({key}):?query:",
          "name": "OrdersObjectPage",
          "target": "OrdersObjectPage"
        },
        {
          "name": "Orders_OrdersToIssuesObjectPage",
          "pattern": "Orders({key})/OrdersToIssues({OrdersToIssuesKey}):?query:",
          "target": "Orders_OrdersToIssuesObjectPage"
        },
        {
          "name": "Orders_OrdersToIssues_IssuesToCommentsObjectPage",
          "pattern": "Orders({key})/OrdersToIssues({OrdersToIssuesKey})/IssuesToComments({IssuesToCommentsKey}):?query:",
          "target": "Orders_OrdersToIssues_IssuesToCommentsObjectPage"
        },
        {
          "name": "Orders_OrdersToIssues_IssuesToAttachmentsObjectPage",
          "pattern": "Orders({key})/OrdersToIssues({OrdersToIssuesKey})/IssuesToAttachments({IssuesToAttachmentsKey}):?query:",
          "target": "Orders_OrdersToIssues_IssuesToAttachmentsObjectPage"
        }
      ],
      "targets": {
        "OrdersList": {
          "type": "Component",
          "id": "OrdersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Orders",
              "variantManagement": "Page",
              "navigation": {
                "Orders": {
                  "detail": {
                    "route": "OrdersObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "defaultTemplateAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#table"
            }
          }
        },
        "OrdersObjectPage": {
          "type": "Component",
          "id": "OrdersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Orders",
              "navigation": {
                "OrdersToIssues": {
                  "detail": {
                    "route": "Orders_OrdersToIssuesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "OrdersToIssues/@com.sap.vocabularies.UI.v1.LineItem#Issues": {
                  "tableSettings": {
                    "creationMode": {
                      "creationFields": "issueType_code,requestType_code"
                    }
                  },
                  "columns": {
                    "Approve": {
                      "header": "apitrigger",
                      "width": "15rem",
                      "position": {
                        "anchor": "DataField::requestType_code",
                        "placement": "After"
                      },
                      "template": "allorders.ext.fragment.Approve",
                      "availability": "Hidden"
                    }
                  }
                }
              },
              "content": {
                "footer": {
                  "actions": {
                    "approvalButton": {
                      "press": "allorders.ext.controller.Approve.onApprove",
                      "visible": "{= !${ui>/isEditable}}",
                      "enabled": true,
                      "text": "Send For Approval"
                    }
                  }
                },
                "body": {
                  "sections": {
                    "ProcessHistory": {
                      "template": "allorders.ext.fragment.ProcessHistory",
                      "position": {
                        "placement": "After",
                        "anchor": "Issues"
                      },
                      "title": "ProcessHistory"
                    }
                  }
                }
              }
            }
          }
        },
        "Orders_OrdersToIssuesObjectPage": {
          "type": "Component",
          "id": "Orders_OrdersToIssuesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {
                "IssuesToComments": {
                  "detail": {
                    "route": "Orders_OrdersToIssues_IssuesToCommentsObjectPage"
                  }
                },
                "IssuesToAttachments": {
                  "detail": {
                    "route": "Orders_OrdersToIssues_IssuesToAttachmentsObjectPage"
                  }
                }
              },
              "contextPath": "/Orders/OrdersToIssues",
              "content": {
                "body": {
                  "sections": {
                    "CommentsFragment": {
                      "template": "allorders.ext.fragment.CommentsFragment",
                      "position": {
                        "placement": "After",
                        "anchor": "GeneralInformation"
                      },
                      "title": "Comments"
                    },
                    "AttachmentsFragment": {
                      "template": "allorders.ext.fragment.AttachmentsFragment",
                      "position": {
                        "placement": "After",
                        "anchor": "CommentsFragment"
                      },
                      "title": "Attachments"
                    }
                  }
                }
              },
              "editableHeaderContent": false
            }
          }
        },
        "Orders_OrdersToIssues_IssuesToCommentsObjectPage": {
          "type": "Component",
          "id": "Orders_OrdersToIssues_IssuesToCommentsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Orders/OrdersToIssues/IssuesToComments"
            }
          }
        },
        "Orders_OrdersToIssues_IssuesToAttachmentsObjectPage": {
          "type": "Component",
          "id": "Orders_OrdersToIssues_IssuesToAttachmentsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Orders/OrdersToIssues/IssuesToAttachments"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController#allorders::Orders_OrdersToIssuesObjectPage": {
            "controllerName": "allorders.ext.controller.Issue"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController#allorders::OrdersObjectPage": {
            "controllerName": "allorders.ext.controller.Orders"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
