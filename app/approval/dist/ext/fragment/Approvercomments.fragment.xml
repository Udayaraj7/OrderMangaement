
<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <VBox
        id="commentsFragmentVBox"
        width="100%"
        class="sapUiSmallMargin"
        core:require="{ handler: 'approval/ext/fragment/Approvercomments' }">

        <HBox 
            id="commentsFragment-ViewAllHBox"
            width="100%" 
            justifyContent="End">
            <Button
                id="commentsFragment-ViewAllButton"
                text="Comments"
                type="Transparent"
                press="handler.onLoadComments"
                icon="sap-icon://comment"/>
        </HBox>

        <TextArea
            id="commentsFragment-CommentTextArea"
            rows="5"
            width="100%"
            placeholder="Enter your comment..."
            />

      

    </VBox>
</core:FragmentDefinition>
