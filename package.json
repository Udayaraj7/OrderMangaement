{
  "name": "orderManagmentSytem",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xsenv": "^6.0.0",
    "@sap/xssec": "^4.12.1",
    "axios": "^1.13.2",
    "express": "^4",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-admin": "cds watch --open admin/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy orderManagmentSytem --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-orders": "cds watch --open orders/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-allorders": "cds watch --open allorders/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-approval": "cds watch --open approval/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-basicproject": "cds watch --open basicproject/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-basicpage2": "cds watch --open basicpage2/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-approvers": "cds watch --open approvers/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": "hana",
      "auth":"dummy"
    },
    "fiori" :{
      "bypass_draft": true
    },
    "features": {
      "draft_lock_timeout": "2m"
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/admin",
    "app/allorders",
    "app/approval",
    "app/approvers"
  ]
}
